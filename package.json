{
  "name": "limn",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "bun run --filter @limn/web dev",
    "build": "bun run --filter @limn/obsidian build && mkdir -p dist && cp packages/obsidian/dist/main.js packages/obsidian/dist/manifest.json packages/obsidian/dist/styles.css dist/",
    "build:web": "bun run --filter @limn/web build",
    "lint": "eslint packages/",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-systemjs": "^7.29.7",
    "baseline-browser-mapping": "^2.11.0",
    "brace-expansion": "^5.0.8",
    "browserslist": "^4.28.7",
    "deepmerge": "4.1.2",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.6",
    "flatted": "^3.4.2",
    "glob": "^14.0.2",
    "lodash": "^4.18.1",
    "minimatch": "^11.0.1",
    "nanoid": "^3.3.16",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.23",
    "serialize-javascript": "^7.1.3",
    "source-map-js": "^1.2.2",
    "vite": "^7.3.7"
  }
}
