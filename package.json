{
  "name": "limn",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "bun run --filter @limn/web dev",
    "build": "bun run --filter @limn/obsidian build && mkdir -p dist && cp packages/obsidian/dist/main.js packages/obsidian/dist/manifest.json packages/obsidian/dist/styles.css dist/",
    "build:web": "bun run --filter @limn/web build",
    "lint": "eslint packages/",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-systemjs": "^7.29.7",
    "brace-expansion": "^5.0.7",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.3",
    "flatted": "^3.4.2",
    "lodash": "^4.18.1",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.16",
    "serialize-javascript": "^7.0.7",
    "vite": "^7.3.6"
  }
}
