{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "semanticCommits": "disabled",
  "schedule": ["* * * * 0,1,6"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 0,1,6"]
  },
  "packageRules": [
    {
      "description": "Group all in-range minor/patch updates into one PR; CI gates it.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "description": "Hold majors for focused, one-at-a-time review via the dependency dashboard.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "0.x minor bumps can be breaking; hold them for approval like majors.",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^0\\./",
      "groupName": null,
      "dependencyDashboardApproval": true
    }
  ]
}
